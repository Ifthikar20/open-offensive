# OpenOffensive configuration — copy to `.env` and fill in.
# A local .env is auto-loaded (unless OPENOFFENSIVE_NO_DOTENV=1) and never overrides
# a real shell environment variable.

# Required for model-driven (LLM) scans, which are the default. Without a key a scan
# errors clearly; pass --mode scripted to run the no-key demo playbook instead.
ANTHROPIC_API_KEY=

# Run mode: auto (LLM when a key is set — the default), llm, or scripted.
OPENOFFENSIVE_LLM_MODE=auto

# Model id used in LLM mode.
OPENOFFENSIVE_MODEL=claude-opus-5

# Execution backend for the agents' tool calls:
#   auto   — Docker if a daemon is reachable, otherwise local host execution (default)
#   docker — require a Kali container (full toolset, real isolation)
#   local  — run tools directly on the host (no container isolation; only host tools)
OPENOFFENSIVE_SANDBOX=auto
