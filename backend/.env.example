# OpenOffensive backend — example environment.
# Copy to `.env` (git-ignored) and fill in real values. NEVER commit a real .env.

# --- Django core ---------------------------------------------------------
# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Leave blank in local development and an ephemeral key is generated per run.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Comma-separated. In DEBUG this defaults to "*". Set real hostnames in production.
DJANGO_ALLOWED_HOSTS=

# --- CORS / CSRF (React dashboard dev server) ----------------------------
# Comma-separated origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ------------------------------------------------------------
# SQLite is used automatically when POSTGRES_DB is empty. For Postgres, set:
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Engine integration --------------------------------------------------
# The API keys the engine needs (e.g. the LLM key) are read by the engine
# subprocess from its own environment — set them here so they are inherited.
ANTHROPIC_API_KEY=

# Python used to launch the engine (defaults to the backend's own interpreter).
OPENOFFENSIVE_ENGINE_PYTHON=
# Where per-scan engine artifacts are written (defaults to backend/runs).
OPENOFFENSIVE_ENGINE_RUNS_DIR=
# Allow scanning non-local URL targets (passes the engine's --authorized flag).
OPENOFFENSIVE_ALLOW_EXTERNAL=false
# Execution backend: auto (try Docker, fall back to host), docker, or local.
OPENOFFENSIVE_ENGINE_SANDBOX=auto
