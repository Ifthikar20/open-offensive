---
// OpenOffensive — landing page. Static, self-contained, no secrets.
const year = new Date().getFullYear();
const github = "https://github.com/Ifthikar20/open-offensive";
const tools = ["nmap", "sqlmap", "nuclei", "httpx", "ffuf", "gobuster", "wafw00f"];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>OpenOffensive — multi-agent AI pentester</title>
    <meta
      name="description"
      content="OpenOffensive spins up an isolated Kali container and turns a team of AI agents loose on your target — streaming every validated finding with a CVSS score, a proof-of-concept, and a fix. Open source, invite-only."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #f5f1e8;
        --panel: #efe9dc;
        --ink: #1b1a16;
        --muted: #6f6a5f;
        --accent: #ef8a3c;
        --accent-deep: #e0701a;
        --dark: #17150f;
        --line: rgba(27, 26, 22, 0.1);
        --radius: 28px;
      }
      * { box-sizing: border-box; }
      html { -webkit-text-size-adjust: 100%; }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--ink);
        font-family: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
        line-height: 1.5;
      }
      .wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
      a { color: inherit; text-decoration: none; }

      /* ---- nav ---- */
      nav {
        display: flex; align-items: center; justify-content: space-between;
        padding: 26px 0 18px;
      }
      .brand { display: flex; align-items: center; gap: 11px; font-weight: 800; font-size: 21px; letter-spacing: -0.02em; }
      .brand .mark { width: 26px; height: 26px; flex: none; }
      .navlinks { display: flex; align-items: center; gap: 26px; font-size: 15px; font-weight: 500; color: #35322b; }
      .navlinks a:hover { color: var(--accent-deep); }
      .navlinks .dot { color: var(--accent); font-weight: 700; }
      .btn {
        display: inline-flex; align-items: center; gap: 10px;
        background: var(--dark); color: #fff; font-weight: 600; font-size: 15px;
        padding: 7px 7px 7px 16px; border-radius: 14px; border: 0; cursor: pointer;
        transition: transform .12s ease, box-shadow .12s ease;
      }
      .btn:hover { transform: translateY(-1px); box-shadow: 0 8px 22px rgba(23,21,15,.22); }
      .btn .sq {
        width: 30px; height: 30px; border-radius: 9px; background: var(--accent);
        display: grid; place-items: center; flex: none;
      }
      .btn .sq svg { width: 16px; height: 16px; }

      /* ---- hero ---- */
      .hero {
        position: relative; overflow: hidden; border-radius: var(--radius);
        min-height: 560px; display: grid; place-items: center; text-align: center;
        padding: 96px 24px; margin-top: 6px;
        box-shadow: 0 30px 80px -40px rgba(120, 60, 10, .55);
      }
      .hero-art { position: absolute; inset: 0; z-index: 0; }
      /* painterly warm sky/landscape, layered gradients + grain */
      .hero-art .sky {
        position: absolute; inset: 0;
        background:
          radial-gradient(120% 90% at 18% 8%, #f7e2c4 0%, rgba(247,226,196,0) 42%),
          radial-gradient(90% 70% at 82% 4%, #f2b06b 0%, rgba(242,176,107,0) 46%),
          radial-gradient(120% 80% at 60% 22%, #ef6a5a 0%, rgba(239,106,90,0) 40%),
          radial-gradient(100% 70% at 30% 30%, #d8536a 0%, rgba(216,83,106,0) 44%),
          radial-gradient(140% 90% at 88% 40%, #7f7f9e 0%, rgba(127,127,158,0) 50%),
          linear-gradient(180deg, #f4a25a 0%, #ef8f43 55%, #ecab52 100%);
      }
      .hero-art .land {
        position: absolute; left: 0; right: 0; bottom: 0; height: 46%;
        background:
          radial-gradient(80% 120% at 12% 0%, #8f3f31 0%, rgba(143,63,49,0) 55%),
          radial-gradient(70% 120% at 82% 6%, #a8502f 0%, rgba(168,80,47,0) 52%),
          linear-gradient(180deg, #e08a2e 0%, #e8a53c 40%, #efc25a 100%);
        clip-path: polygon(0 34%, 12% 22%, 20% 30%, 30% 16%, 41% 28%, 55% 12%, 68% 26%, 80% 14%, 100% 30%, 100% 100%, 0 100%);
        opacity: .96;
      }
      .hero-art .grain {
        position: absolute; inset: 0; opacity: .16; mix-blend-mode: overlay;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
      }
      .hero-inner { position: relative; z-index: 1; max-width: 900px; }
      h1 {
        margin: 0; color: #fff; font-weight: 800; letter-spacing: -0.03em;
        font-size: clamp(38px, 6.4vw, 76px); line-height: 1.04;
        text-shadow: 0 2px 30px rgba(60, 24, 8, .35);
      }
      h1 em { font-style: italic; font-weight: 700; }
      .sub {
        margin: 26px auto 0; max-width: 620px; color: #fff;
        font-size: clamp(15px, 1.6vw, 18px); font-weight: 500; line-height: 1.6;
        text-shadow: 0 1px 18px rgba(60, 24, 8, .4);
      }
      .cta-row { margin-top: 34px; display: flex; flex-direction: column; align-items: center; gap: 14px; }
      .cta {
        display: inline-flex; align-items: center; gap: 12px;
        background: var(--dark); color: #fff; font-weight: 600; font-size: 17px;
        padding: 9px 9px 9px 20px; border-radius: 16px; cursor: pointer;
        transition: transform .12s ease, box-shadow .12s ease;
      }
      .cta:hover { transform: translateY(-1px); box-shadow: 0 14px 34px rgba(23,21,15,.35); }
      .cta .sq { width: 36px; height: 36px; border-radius: 11px; background: var(--accent); display: grid; place-items: center; }
      .cta .sq svg { width: 19px; height: 19px; }
      .cta-alt { color: #fff; font-size: 14px; font-weight: 500; opacity: .92; }
      .cta-alt a { text-decoration: underline; text-underline-offset: 3px; }

      /* ---- trust strip ---- */
      .trust { text-align: center; padding: 62px 0 56px; }
      .trust .eyebrow { font-weight: 700; font-size: 15px; color: #2f2c25; }
      .trust .chips {
        margin-top: 22px; display: flex; flex-wrap: wrap; gap: 12px 14px;
        align-items: center; justify-content: center;
      }
      .chip {
        font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        font-size: 15px; font-weight: 600; color: #55503f;
        background: var(--panel); border: 1px solid var(--line);
        padding: 7px 14px; border-radius: 999px;
      }
      .chip .g { color: var(--accent-deep); }

      /* ---- footer ---- */
      footer {
        border-top: 1px solid var(--line); margin-top: 10px; padding: 26px 0 44px;
        display: flex; align-items: center; justify-content: space-between; gap: 16px;
        font-size: 14px; color: var(--muted); flex-wrap: wrap;
      }
      footer .fl { display: flex; gap: 20px; flex-wrap: wrap; }
      footer a:hover { color: var(--accent-deep); }

      @media (max-width: 720px) {
        .navlinks { display: none; }
        .hero { padding: 64px 18px; min-height: 500px; border-radius: 22px; }
        .wrap { padding: 0 16px; }
      }
    </style>
  </head>

  <body>
    <div class="wrap">
      <!-- nav -->
      <nav>
        <div class="brand">
          <svg class="mark" viewBox="0 0 32 32" fill="none" stroke="var(--accent-deep)" stroke-width="2.4">
            <circle cx="16" cy="16" r="11" />
            <circle cx="16" cy="16" r="4.5" />
            <path d="M16 1v4M16 27v4M1 16h4M27 16h4" stroke-linecap="round" />
          </svg>
          <span>OpenOffensive</span>
        </div>
        <div class="navlinks">
          <a href="#how">How it works</a><span class="dot">•</span>
          <a href={github + "/tree/main/docs"}>Docs</a><span class="dot">•</span>
          <a href={github}>GitHub</a>
        </div>
        <a class="btn" href="#access">
          <span class="sq">
            <svg viewBox="0 0 24 24" fill="none" stroke="#17150f" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
          </span>
          Get access
        </a>
      </nav>

      <!-- hero -->
      <section class="hero">
        <div class="hero-art" aria-hidden="true">
          <div class="sky"></div>
          <div class="land"></div>
          <div class="grain"></div>
        </div>
        <div class="hero-inner">
          <h1>The AI pentester that<br />works <em>with</em> your team, not just <em>for</em> you</h1>
          <p class="sub">
            OpenOffensive spins up an isolated Kali container and turns a team of AI agents loose on
            your target — recon, injection, access — streaming every validated finding with a CVSS
            score, a proof-of-concept, and a fix.
          </p>
          <div class="cta-row" id="access">
            <a class="cta" href={github}>
              <span class="sq">
                <svg viewBox="0 0 24 24" fill="none" stroke="#17150f" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
              </span>
              Request access
            </a>
            <div class="cta-alt">Open source · Invite-only beta · <a href={github}>Have an invite? Sign in</a></div>
          </div>
        </div>
      </section>

      <!-- trust strip -->
      <section class="trust" id="how">
        <div class="eyebrow">Powered by the tools you already trust</div>
        <div class="chips">
          {tools.map((t) => (
            <span class="chip"><span class="g">$</span> {t}</span>
          ))}
        </div>
      </section>

      <!-- footer -->
      <footer>
        <div>© {year} OpenOffensive · MIT licensed</div>
        <div class="fl">
          <a href={github}>GitHub</a>
          <a href={github + "/tree/main/docs"}>Docs</a>
          <a href={github + "/blob/main/docs/SECURITY.md"}>Security</a>
        </div>
      </footer>
    </div>
  </body>
</html>
